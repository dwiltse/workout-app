# Database Connection
# Get this from your Neon dashboard: https://neon.tech

# OPTION 1: Full connection string (EASIEST - just copy/paste from Neon)
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# OPTION 2: Individual credentials (alternative to DATABASE_URL)
# Uncomment these if you prefer to use individual values instead
# NEON_HOST=ep-your-endpoint-here.region.azure.neon.tech
# NEON_USER=neondb_owner
# NEON_DATABASE=neondb
# NEON_PASSWORD=your-password-here

# Optional: FatSecret API (for nutrition sync - coming soon)
# FATSECRET_CLIENT_ID=""
# FATSECRET_CLIENT_SECRET=""